# —— Coze 智能回复（不填则回退固定回复 "1"）——
# COZE_API_KEY=
# BOT_ID=
# COZE_BASE_URL=https://api.coze.cn
# COZE_USER_ID=douyin-auto-reply

# 自动回复脚本打开的页面（默认：创作平台互动-私信）
# DOUYIN_REPLY_PAGE_URL=https://creator.douyin.com/creator-micro/interactive/message

# 轮询间隔（毫秒，默认已加大以降低风控风险）
# AUTO_REPLY_POLL_MS=25000
# AUTO_REPLY_POLL_MS_AUTO_RANGE=18000-32000

# —— 操作节流（毫秒）——
# 支持三种写法：
# 1) 固定值：DOUYIN_DELAY_BEFORE_COMPOSE_MS=4000
# 2) auto：DOUYIN_DELAY_BEFORE_COMPOSE_MS=auto（会读取 *_AUTO_RANGE）
# 3) 直接范围：DOUYIN_DELAY_BEFORE_COMPOSE_MS=3000-6000（或 3000,6000）
#
# auto 范围字段统一命名：<变量名>_AUTO_RANGE=min-max
# 例如：DOUYIN_DELAY_BEFORE_COMPOSE_MS_AUTO_RANGE=3000-6000
#
# 无未读私信后，再等多久才进入「评论管理…」流程
# DOUYIN_COOLDOWN_BEFORE_COMMENT_MS=18000
# DOUYIN_COOLDOWN_BEFORE_COMMENT_MS_AUTO_RANGE=12000-24000
# 打开会话 / 评论「回复」后，再等多久才输入并发送
# DOUYIN_DELAY_BEFORE_COMPOSE_MS=4000
# DOUYIN_DELAY_BEFORE_COMPOSE_MS_AUTO_RANGE=2500-5500
# trySendReply 成功后冷却
# DOUYIN_COOLDOWN_AFTER_SEND_MS=10000
# DOUYIN_COOLDOWN_AFTER_SEND_MS_AUTO_RANGE=7000-14000
# trySendReply 失败后冷却
# DOUYIN_COOLDOWN_AFTER_SEND_FAIL_MS=6000
# DOUYIN_COOLDOWN_AFTER_SEND_FAIL_MS_AUTO_RANGE=4000-9000
# 侧栏、筛选等步骤间隔
# DOUYIN_UI_STEP_DELAY_MS=2000
# DOUYIN_UI_STEP_DELAY_MS_AUTO_RANGE=1200-3000
# 输入框 fill 后到点击「发送」
# DOUYIN_DELAY_FILL_TO_SEND_MS=900
# DOUYIN_DELAY_FILL_TO_SEND_MS_AUTO_RANGE=600-1400

# 创作平台首页（侧边栏「互动管理」入口）
# DOUYIN_CREATOR_HOME_URL=https://creator.douyin.com/

# 若 DOM 变更，可覆盖默认 XPath（见 src/creatorPrivateMessageNav.ts）
# DOUYIN_XPATH_INTERACTION=
# DOUYIN_XPATH_PRIVATE_MESSAGE=
# DOUYIN_XPATH_UNREAD_BADGE=

# 评论自动回复（无未读私信时）
# DOUYIN_XPATH_COMMENT=
# DOUYIN_XPATH_ALL_COMMENTS=
# DOUYIN_XPATH_UNREPLIED=
# DOUYIN_XPATH_FIRST_COMMENT_REPLY=
# 评论回复面板内输入框与发送（XPath）
# DOUYIN_XPATH_COMMENT_COMPOSER=
# DOUYIN_XPATH_COMMENT_SEND=

# Coze 接入前：抓取「用户原文」的可选 XPath（不配则用启发式）
# DOUYIN_XPATH_DM_USER_MESSAGE=
# DOUYIN_XPATH_COMMENT_USER_TEXT=
# 评论发送后回到私信前等待
# DOUYIN_DELAY_AFTER_COMMENT_RETURN_DM_MS=6000
# DOUYIN_DELAY_AFTER_COMMENT_RETURN_DM_MS_AUTO_RANGE=4000-9000
# 执行「切回私信管理」动作前等待（用于页面刷新）
# DOUYIN_DELAY_BEFORE_SWITCH_DM_MS=1000
# DOUYIN_DELAY_BEFORE_SWITCH_DM_MS_AUTO_RANGE=600-1800
