# —— 可选：后期接入 Coze 智能化时再填写（当前脚本不使用）——
# COZE_API_KEY=
# BOT_ID=

# 自动回复脚本打开的页面（默认：创作平台互动-私信）
# DOUYIN_REPLY_PAGE_URL=https://creator.douyin.com/creator-micro/interactive/message

# 轮询间隔（毫秒，默认已加大以降低风控风险）
# AUTO_REPLY_POLL_MS=25000

# —— 操作节流（毫秒）——
# 无未读私信后，再等多久才进入「评论管理…」流程
# DOUYIN_COOLDOWN_BEFORE_COMMENT_MS=18000
# 打开会话 / 评论「回复」后，再等多久才输入并发送
# DOUYIN_DELAY_BEFORE_COMPOSE_MS=4000
# trySendReply 成功后冷却
# DOUYIN_COOLDOWN_AFTER_SEND_MS=10000
# trySendReply 失败后冷却
# DOUYIN_COOLDOWN_AFTER_SEND_FAIL_MS=6000
# 侧栏、筛选等步骤间隔
# DOUYIN_UI_STEP_DELAY_MS=2000
# 输入框 fill 后到点击「发送」
# DOUYIN_DELAY_FILL_TO_SEND_MS=900

# 创作平台首页（侧边栏「互动管理」入口）
# DOUYIN_CREATOR_HOME_URL=https://creator.douyin.com/

# 若 DOM 变更，可覆盖默认 XPath（见 src/creatorPrivateMessageNav.ts）
# DOUYIN_XPATH_INTERACTION=
# DOUYIN_XPATH_PRIVATE_MESSAGE=
# DOUYIN_XPATH_UNREAD_BADGE=

# 评论自动回复（无未读私信时）
# DOUYIN_XPATH_COMMENT=
# DOUYIN_XPATH_ALL_COMMENTS=
# DOUYIN_XPATH_UNREPLIED=
# DOUYIN_XPATH_FIRST_COMMENT_REPLY=
# 评论回复面板内输入框与发送（XPath）
# DOUYIN_XPATH_COMMENT_COMPOSER=
# DOUYIN_XPATH_COMMENT_SEND=

# Coze 接入前：抓取「用户原文」的可选 XPath（不配则用启发式）
# DOUYIN_XPATH_DM_USER_MESSAGE=
# DOUYIN_XPATH_COMMENT_USER_TEXT=
# 评论发送后回到私信前等待
# DOUYIN_DELAY_AFTER_COMMENT_RETURN_DM_MS=6000
